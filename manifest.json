{
  "manifest_version": 3,
  "name": "Mizpah Ad Blocker",
  "short_name": "Mizpah",
  "version": "1.0.0",
  "description": "Blocks ads, trackers, pop-ups and cookie banners. Fast, private, and built on EasyList with daily filter updates.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mizpah",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "ads-extra",
        "enabled": true,
        "path": "rules/ads-extra.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "trackers-extra",
        "enabled": true,
        "path": "rules/trackers-extra.json"
      },
      {
        "id": "annoyances",
        "enabled": true,
        "path": "rules/annoyances.json"
      },
      {
        "id": "annoyances-extra",
        "enabled": true,
        "path": "rules/annoyances-extra.json"
      }
    ]
  }
}
